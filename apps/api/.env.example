ENTRA_API_CLIENT_ID=f0d8466d-2736-44d3-b22a-d581a7ac7acc
ENTRA_WEB_CLIENT_ID=21423ef9-28b7-4c69-a91c-221c1e2cd564
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
API_HOST=127.0.0.1

# Replace with a generated password for the restricted database role. Never use postgres here.
DATABASE_URL=postgresql://caseflow_runtime:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:54322/postgres

# Optional document storage. Set all three values together to enable the S3 client.
# S3_BUCKET=your-private-document-bucket
# AWS_REGION=us-east-2
# S3_ENVIRONMENT=dev
# Local development only: a restricted assume-role profile, never the administrator profile.
# AWS_PROFILE=caseflow-api-dev

# Enable only after the processing migration, dispatcher login, SQS permission, and consumer are ready.
PROCESSING_DISPATCHER_ENABLED=false
# PROCESSING_DISPATCHER_DATABASE_URL=
# PROCESSING_QUEUE_URL=
# Uses AWS_REGION and the optional AWS_PROFILE configured above.

# Keep disabled until the extraction infrastructure and quality evaluation are approved.
FACT_EXTRACTION_DISPATCHER_ENABLED=false
FACT_EXTRACTION_DISPATCHER_DATABASE_URL=
FACT_EXTRACTION_QUEUE_URL=

# Optional "Continue as demo admin" sign-in on /demo. Keep disabled unless this environment is a
# public demo; when enabled, set DEMO_SESSION_SECRET to at least 32 random characters.
DEMO_LOGIN_ENABLED=false
DEMO_SESSION_SECRET=
