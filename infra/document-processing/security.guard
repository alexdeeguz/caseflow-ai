let log_groups = Resources.*[ Type == 'AWS::Logs::LogGroup' ]
let functions = Resources.*[ Type == 'AWS::Serverless::Function' ]

rule runtime_limits {
    Globals.Function.Runtime == 'python3.13'
    Globals.Function.Architectures == ['x86_64']
    Globals.Function.MemorySize == 1024
    Globals.Function.Timeout == 120
    Globals.Function.EphemeralStorage.Size == 512
    Globals.Function.VpcConfig !exists
    Globals.Function.Environment.Variables.PROCESSOR_DATABASE_URL !exists
    Parameters.EnableProcessingConsumer.Default == 'false'
    Parameters.EnableCompletionConsumer.Default == 'false'
}

rule restricted_stack_ownership {
    Resources.*.Type IN ['AWS::IAM::Role', 'AWS::Logs::LogGroup', 'AWS::Serverless::Function', 'AWS::Scheduler::Schedule', 'AWS::Scheduler::ScheduleGroup', 'AWS::CloudWatch::Alarm', 'AWS::CloudWatch::Dashboard']
}

rule private_function_logging {
    %functions.Properties {
        FunctionUrlConfig !exists
        VpcConfig !exists
        LoggingConfig.LogFormat == 'JSON'
        LoggingConfig.ApplicationLogLevel == 'INFO'
    }
    %log_groups {
        Properties.RetentionInDays == 30
        DeletionPolicy == 'Retain'
        UpdateReplacePolicy == 'Retain'
    }
}


rule bounded_reconciliation {
    Parameters.EnableRecoverySchedule.Default == 'false'
    Resources.RecoverySchedule.Properties.ScheduleExpression == 'rate(5 minutes)'
    Resources.RecoverySchedule.Properties.FlexibleTimeWindow.Mode == 'OFF'
    Resources.RecoveryFunction.Properties.ReservedConcurrentExecutions !exists
    Resources.RecoveryFunction.Properties.EventInvokeConfig.MaximumRetryAttempts == 0
    Resources.RecoveryFunction.Properties.Environment.Variables.PROCESSOR_DATABASE_SECRET_ARN !exists
}
